# ---- LLM providers (multi-provider — agents pick a provider per call) ----
ANTHROPIC_API_KEY="sk-ant-..."
GROQ_API_KEY="gsk_..."
NVIDIA_NIM_API_KEY="nvapi-..."
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
# Any additional OpenAI-compatible open-source model endpoint (local Ollama,
# vLLM, Together AI, etc.) can be wired in the same way — base URL + key.
OPENSOURCE_LLM_BASE_URL=""
OPENSOURCE_LLM_API_KEY=""

# ---- Sandboxed code execution ----
E2B_API_KEY="..."

# ---- Service-to-service auth (must match apps/api/.env exactly) ----
INTERNAL_SECRET="<same exact value you put in apps/api/.env>"
NODE_API_URL="http://localhost:5000"

# ---- Database (Supabase PostgreSQL — pooled connection) ----
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---- Vector store (Qdrant — used by matchmaking/RAG agents) ----
QDRANT_URL="https://xxx.qdrant.io"
QDRANT_API_KEY="..."

# ---- Server ----
PORT=8000
