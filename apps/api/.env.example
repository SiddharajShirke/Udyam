# ---- Database (Supabase PostgreSQL) ----
# Pooled connection (pgbouncer) — used at runtime by the Prisma Client.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection — used by `prisma migrate`.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ---- Auth ----
JWT_SECRET="<any long random string>"

# ---- Service-to-service auth (must match apps/ai-engine/.env exactly) ----
INTERNAL_SECRET="<any long random string — must match ai-engine's .env exactly>"
AI_ENGINE_URL="http://localhost:8000"

# ---- Server ----
CORS_ORIGIN="http://localhost:3000"
PORT=5000

# ---- File uploads (optional — used by apps/api/src/routes when built) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
